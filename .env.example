# ReguGuard environment — copy to .env and fill in.

# Required GCP
GOOGLE_CLOUD_PROJECT="your-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GENAI_USE_VERTEXAI="true"

# Model SKUs (VERIFY against Model Garden / gcloud ai models list)
ORCHESTRATOR_MODEL="gemini-2.5-pro"
WORKER_MODEL="gemini-2.5-flash"

# Service accounts (filled after Phase 0.2 Terraform / IAM setup)
SA_AGENT="reguguard-agent@your-project-id.iam.gserviceaccount.com"
SA_MCP="reguguard-mcp@your-project-id.iam.gserviceaccount.com"

# BigQuery
BQ_DATASET="reguguard"
BQ_TXN_TABLE="transactions"
BQ_LABELS_TABLE="labels"

# MCP endpoints (local defaults; replace after Cloud Run deploy)
TRANSACTION_MCP_URL="http://localhost:8080/mcp"
SANCTIONS_MCP_URL="http://localhost:8081/mcp"

# Vertex RAG (filled after Phase 3)
RAG_CORPUS_RESOURCE=""
RAG_STAGING_BUCKET=""

# Model Armor (filled after Phase 4)
MODEL_ARMOR_TEMPLATE=""
MODEL_ARMOR_ENABLED="false"

# HITL
HITL_RISK_THRESHOLD="0.80"

# Agent Engine staging (Phase 5)
STAGING_BUCKET=""
AGENT_ENGINE_RESOURCE=""
